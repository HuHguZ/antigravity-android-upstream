#!/usr/bin/env python3
"""
agy-mcp-telegram - Zero-dependency-at-startup Python 3 stdio MCP server for
personal Telegram (MTProto via Telethon).

Imports `telethon` lazily so the MCP server ALWAYS starts cleanly even before
the user installs `telethon` or runs `agy-tg-setup`, returning clear 1-step
setup instructions instead of crashing.

Credentials & session are stored strictly under:
  $HOME/.gemini/antigravity-app/telegram/config.json  (mode 0600)
  $HOME/.gemini/antigravity-app/telegram/user.session (mode 0600)

Protocol: JSON-RPC 2.0 over newline-delimited stdin/stdout (MCP 2024-11-05+).
"""

import os
import sys
import json
import asyncio
import importlib

SERVER_NAME = "telegram"
SERVER_VERSION = "1.0.0"
SUPPORTED_PROTOCOL_VERSIONS = ("2025-06-18", "2025-03-26", "2024-11-05")
DEFAULT_PROTOCOL_VERSION = "2024-11-05"

_LOOP = None
_CLIENT = None


def get_prefix():
    env_prefix = os.environ.get("PREFIX", "").strip()
    if env_prefix:
        return env_prefix
    return os.path.dirname(os.path.dirname(os.path.realpath(__file__)))


def get_home():
    env_home = os.environ.get("HOME", "").strip()
    if env_home:
        return env_home
    return os.path.dirname(get_prefix())


def get_telegram_dir():
    override = os.environ.get("AGY_TELEGRAM_DIR", "").strip()
    if override:
        return override
    return os.path.join(get_home(), ".gemini", "antigravity-app", "telegram")


def get_config_path():
    return os.path.join(get_telegram_dir(), "config.json")


def get_session_base_path():
    return os.path.join(get_telegram_dir(), "user")


def get_session_file_path():
    return get_session_base_path() + ".session"


def _load_telethon():
    try:
        mod = importlib.import_module("telethon")
        return mod, None
    except Exception as e:
        return None, str(e)


def _load_config():
    path = get_config_path()
    if not os.path.isfile(path):
        return None, f"Telegram config not found at {path}"
    try:
        with open(path, "r", encoding="utf-8") as f:
            data = json.load(f)
        api_id = int(data.get("api_id", 0))
        api_hash = str(data.get("api_hash") or "").strip()
        if api_id <= 0 or not api_hash:
            return None, "Invalid api_id or api_hash in Telegram config.json"
        return {"api_id": api_id, "api_hash": api_hash}, None
    except Exception as e:
        return None, f"Failed reading Telegram config.json: {e}"


def _setup_instructions(reason):
    return {
        "ok": False,
        "configured": False,
        "error": reason,
        "setup_command": "agy-tg-setup",
        "instructions": (
            "Run `agy-tg-setup` in the Antigravity terminal. It will install Telethon if missing, "
            "prompt for your API_ID and API_HASH from https://my.telegram.org/apps, and sign in "
            "to your Telegram account (saving credentials with 0600 permissions under "
            f"{get_telegram_dir()})."
        ),
    }


def _get_event_loop():
    global _LOOP
    if _LOOP is None or _LOOP.is_closed():
        _LOOP = asyncio.new_event_loop()
        asyncio.set_event_loop(_LOOP)
    return _LOOP


def _run_async(coro):
    loop = _get_event_loop()
    return loop.run_until_complete(coro)


async def _get_authorized_client():
    global _CLIENT
    telethon_mod, import_err = _load_telethon()
    if telethon_mod is None:
        return None, _setup_instructions(f"telethon is not installed ({import_err})")

    cfg, cfg_err = _load_config()
    if cfg is None:
        return None, _setup_instructions(cfg_err)

    session_file = get_session_file_path()
    if not os.path.isfile(session_file):
        return None, _setup_instructions(f"Telegram session not found at {session_file}")

    if _CLIENT is None:
        client_cls = getattr(telethon_mod, "TelegramClient")
        _CLIENT = client_cls(get_session_base_path(), cfg["api_id"], cfg["api_hash"])

    if not _CLIENT.is_connected():
        await _CLIENT.connect()

    if not await _CLIENT.is_user_authorized():
        return None, _setup_instructions("Telegram session is not authorized; run `agy-tg-setup` to sign in again.")

    return _CLIENT, None


async def _close_client():
    global _CLIENT
    if _CLIENT is not None:
        try:
            await _CLIENT.disconnect()
        except Exception:
            pass
        _CLIENT = None


def _dialog_type(dialog):
    if getattr(dialog, "is_channel", False) and not getattr(dialog, "is_group", False):
        return "channel"
    if getattr(dialog, "is_group", False):
        return "group"
    if getattr(dialog, "is_user", False):
        return "user"
    return "other"


def _iso_date(dt):
    if dt is None:
        return None
    try:
        return dt.isoformat()
    except Exception:
        return str(dt)


def _media_type(msg):
    media = getattr(msg, "media", None)
    if media is None:
        return None
    return type(media).__name__


def _sender_display(msg):
    sender = getattr(msg, "sender", None)
    if sender is not None:
        first = getattr(sender, "first_name", "") or ""
        last = getattr(sender, "last_name", "") or ""
        title = getattr(sender, "title", "") or ""
        uname = getattr(sender, "username", "") or ""
        full = (f"{first} {last}").strip() or title
        if full and uname:
            return f"{full} (@{uname})"
        if full:
            return full
        if uname:
            return f"@{uname}"
    sid = getattr(msg, "sender_id", None)
    return str(sid) if sid is not None else ""


def _serialize_message(msg):
    text = getattr(msg, "message", None)
    if text is None:
        text = getattr(msg, "text", "") or ""
    return {
        "id": getattr(msg, "id", None),
        "sender": _sender_display(msg),
        "date": _iso_date(getattr(msg, "date", None)),
        "text": str(text),
        "media_type": _media_type(msg),
    }


def _serialize_dialog(dialog):
    entity = getattr(dialog, "entity", None)
    username = getattr(entity, "username", None) if entity is not None else None
    return {
        "id": getattr(dialog, "id", None),
        "title": str(getattr(dialog, "name", "") or getattr(dialog, "title", "") or ""),
        "username": f"@{username}" if username and not str(username).startswith("@") else username,
        "type": _dialog_type(dialog),
        "unread_count": int(getattr(dialog, "unread_count", 0) or 0),
        "last_message_date": _iso_date(getattr(dialog, "date", None)),
    }


async def _resolve_chat_entity(client, chat_ref):
    raw = str(chat_ref or "").strip()
    if not raw:
        raise ValueError("chat is required")

    # Numeric chat ID
    if raw.lstrip("-").isdigit():
        return await client.get_entity(int(raw))

    # @username
    if raw.startswith("@"):
        return await client.get_entity(raw)

    # Try direct get_entity first; fall back to case-insensitive dialog title match
    try:
        return await client.get_entity(raw)
    except Exception:
        needle = raw.lower()
        dialogs = await client.get_dialogs(limit=100)
        for d in dialogs:
            title = str(getattr(d, "name", "") or getattr(d, "title", "") or "").lower()
            entity = getattr(d, "entity", None)
            uname = str(getattr(entity, "username", "") or "").lower()
            if title == needle or uname == needle:
                return entity if entity is not None else d
        for d in dialogs:
            title = str(getattr(d, "name", "") or getattr(d, "title", "") or "").lower()
            if needle in title:
                entity = getattr(d, "entity", None)
                return entity if entity is not None else d
        raise ValueError(f"Could not find Telegram chat matching {raw!r}")


# -----------------------------------------------------------------------------
# Tool Definitions (MCP JSON Schema)
# -----------------------------------------------------------------------------
